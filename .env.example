# MedTwin AI - Environment Configuration Example
# Copy this file to .env and adjust values as needed. NEVER commit real secrets to Git.

# Application Settings
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (SQLite default or PostgreSQL)
DATABASE_URL=sqlite:///./medtwin.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/medtwin_db

# LLM Provider: auto | ollama | huggingface
# In "auto" mode, attempts local Ollama first, then falls back to Hugging Face Inference API
LLM_PROVIDER=auto

# Ollama LLM Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60

# Hugging Face Inference API (Cloud / Streamlit Cloud)
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_TIMEOUT_SECONDS=30

# Emergency Services Numbers (Configurable)
EMERGENCY_NUMBERS="112, 108, 911"

# RAG & Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chromadb
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.25

# Caching
CACHE_TTL_SECONDS=3600

# Whisper Voice Input (Local STT)
WHISPER_MODEL_NAME=tiny
ENABLE_VOICE_INPUT=True
