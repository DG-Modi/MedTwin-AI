# MedTwin AI - Environment Configuration Example
# Copy this file to .env and adjust values as needed. NEVER commit real secrets to Git.

# Application Settings
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# SQLite Database
DATABASE_URL=sqlite:///./medtwin.db

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=60
# When True, falls back gracefully to a mock medical LLM generator if Ollama is unreachable
ENABLE_MOCK_LLM_FALLBACK=True

# RAG & Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chromadb
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.3

# Caching
CACHE_TTL_SECONDS=3600

# Whisper / Voice (Optional local STT)
WHISPER_MODEL_SIZE=base
